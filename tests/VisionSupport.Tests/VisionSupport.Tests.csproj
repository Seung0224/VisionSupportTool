<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisionSupport.PlcServer\VisionSupport.PlcServer.csproj" />
    <ProjectReference Include="..\..\src\VisionSupport.MemoryMonitor\VisionSupport.MemoryMonitor.csproj" />
    <ProjectReference Include="..\..\src\VisionSupport.ImageConverter\VisionSupport.ImageConverter.csproj" />
    <ProjectReference Include="..\..\src\VisionSupport\VisionSupport.csproj" />
  </ItemGroup>

  <!-- The shell copies the optional Cognex codec into plugins\, and referencing the shell drags
       that copy in here too. CognexCodecLoader looks for the plugin next to the running binary,
       so its "plugin is absent" test would be checking a machine where the plugin is present.
       The test host is not the shell and has no use for the plugin either way. -->
  <Target Name="DropShellPluginFromTestOutput" AfterTargets="Build">
    <Delete Files="$(OutputPath)plugins\VisionSupport.ImageConverter.Cognex.dll" ContinueOnError="true"/>
  </Target>

</Project>
