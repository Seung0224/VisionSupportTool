<!--
    The PLC feature's theme, scoped rather than global.

    This used to live in the standalone app's App.xaml as a light Material theme. Inside the
    support shell it has to do two things instead: look like the rest of the shell (VS dark), and
    stay out of the shell's way. So it is merged into the feature's own views rather than into
    Application.Resources - WPF resolves resources up the visual tree, so Material's implicit
    styles apply inside this feature and nowhere else, and the shell's implicit styles keep
    every other page. Two full control themes in one process only coexist because of that.

    Material is kept rather than rewritten: ten dialogs depend on its styles and its DialogHost,
    and switching its base theme to dark plus overriding the palette gets the same look for a
    fraction of the risk of reimplementing them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>
        <!-- Primary/secondary are the shell's accent pair, so Material's own accents match the
             nav rail and the command bar rather than sitting next to them. -->
        <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="#0E639C" SecondaryColor="#1F9CF0" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The feature's own surfaces, pinned to the shell's palette rather than Material's greys
         so a card here and a card on the idle screen are the same colour. -->
    <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF252526" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FF3F3F46" />

    <SolidColorBrush x:Key="AppForegroundBrush" Color="#FFD4D4D4" />
    <SolidColorBrush x:Key="AppDimForegroundBrush" Color="#FF9D9D9D" />

    <!-- Run-state chips. Same green and same salmon the shell uses for its own state dots. -->
    <SolidColorBrush x:Key="StatusRunningBrush" Color="#FF6A9955" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#FFF48771" />

</ResourceDictionary>
