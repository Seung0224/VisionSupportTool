<Window x:Class="VirtualPlcServer.Views.ScenarioEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
        xmlns:local="clr-namespace:VirtualPlcServer.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ScenarioEditorViewModel}"
        Title="Scenario" Height="560" Width="640"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <!-- Own visual tree, so the feature's scoped theme is merged here too. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionSupport.PlcServer;component/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <materialDesign:DialogHost Identifier="ScenarioDialog">
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="{Binding ScenarioName}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Top" Text="Rules run top to bottom, whenever the scenario is active (checkbox on the board)."
                       Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="11" Margin="0,0,0,12" />

            <Button DockPanel.Dock="Top" Content="ADD RULE" Command="{Binding AddRuleCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <TextBlock DockPanel.Dock="Top" Text="No rules yet - click ADD RULE to build the first condition/action."
                       Foreground="{DynamicResource AppDimForegroundBrush}" FontStyle="Italic" Margin="0,0,0,8"
                       Visibility="{Binding Rules.Count, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}" />

            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScenarioRuleRowViewModel}">
                        <materialDesign:Card Margin="0,0,0,8" Padding="12"
                                              BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding DeleteCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="28" Height="28" Padding="0" ToolTip="Remove Rule">
                                    <TextBlock Text="✕" FontSize="12" />
                                </Button>
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </materialDesign:DialogHost>
</Window>
