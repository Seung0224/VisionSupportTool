<UserControl x:Class="VirtualPlcServer.Views.BoardLayoutToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <!-- Card / list switch for the module board. It lives in the shell's caption, outside the PLC
         feature's Material theme, so it carries its own small style instead of borrowing one. -->
    <UserControl.Resources>
        <Style x:Key="LayoutOption" TargetType="RadioButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF8A8A8A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="#FFD0D0D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#33FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <RadioButton GroupName="BoardLayout" Style="{StaticResource LayoutOption}"
                     IsChecked="{Binding IsGridLayout, Mode=TwoWay}" ToolTip="카드형">
            <fa:IconBlock Icon="TableCellsLarge" FontSize="13"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </RadioButton>
        <RadioButton GroupName="BoardLayout" Style="{StaticResource LayoutOption}" Margin="2,0,0,0"
                     IsChecked="{Binding IsListLayout, Mode=TwoWay}" ToolTip="목록형">
            <fa:IconBlock Icon="List" FontSize="13"
                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
        </RadioButton>
    </StackPanel>
</UserControl>
