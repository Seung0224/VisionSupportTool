<Window x:Class="VirtualPlcServer.Views.ConfirmArrayLengthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm Array Lengths" Width="560" Height="430"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <!-- DialogHost 안에 또 DialogHost를 띄울 수 없어서(추가 모듈 창이 이미 그 안에 떠 있다)
         이 확인 창만 일반 Window로 만든다. 그래서 테마도 직접 머지한다. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionSupport.PlcServer;component/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="이 설정 파일 형식에는 배열 길이가 들어있지 않습니다. 아래 길이를 확인·수정한 뒤 생성하세요." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="CANCEL" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0" />
            <Button Content="CREATE" Click="OnConfirmClicked" Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="ErrorText" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource StatusStoppedBrush}" />

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  materialDesign:DataGridAssist.CellPadding="8,4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Node" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding DataType}" IsReadOnly="True" Width="100" />
                <DataGridTextColumn Header="Length" Binding="{Binding ArrayLength}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
