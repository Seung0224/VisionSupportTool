<UserControl x:Class="VirtualPlcServer.Views.TargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
             xmlns:local="clr-namespace:VirtualPlcServer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TargetPickerViewModel}">
    <!-- Module + address (MC: typed D-number, OPC UA/ADS: picked node) + array index.
         Only implicit styles here: the theme comes from the dialog this sits in, which is not
         connected yet while this control parses, so StaticResource theme keys would not resolve. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <ComboBox materialDesign:HintAssist.Hint="Module" ItemsSource="{Binding AvailableModules}"
                  DisplayMemberPath="Name" SelectedItem="{Binding SelectedModule}" Margin="0,4" />

        <!-- OPC UA/ADS: pick a node from the module's actual node list -->
        <ComboBox materialDesign:HintAssist.Hint="Node"
                  Visibility="{Binding IsNodeBased, Converter={StaticResource BooleanToVisibilityConverter}}"
                  ItemsSource="{Binding Nodes}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedNode}" Margin="0,4" />

        <!-- MC: type the D-address -->
        <TextBox materialDesign:HintAssist.Hint="Address (D-number)"
                 Visibility="{Binding IsNodeBased, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" />

        <TextBox materialDesign:HintAssist.Hint="Array Index"
                 Visibility="{Binding IsArraySelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Text="{Binding ArrayIndex}" Margin="0,4" />
    </StackPanel>
</UserControl>
