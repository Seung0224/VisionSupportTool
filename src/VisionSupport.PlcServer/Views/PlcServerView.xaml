<!--
    Was the standalone hub's MainWindow; now a page in the support shell. The window chrome is
    the shell's, and the Material theme that used to sit in App.xaml is merged here instead so it
    styles this feature only - see Themes/AppTheme.xaml for why that scoping matters.
-->
<UserControl x:Class="VirtualPlcServer.Views.PlcServerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
        xmlns:local="clr-namespace:VirtualPlcServer.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionSupport.PlcServer;component/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:RunStateToBrushConverter x:Key="RunStateToBrushConverter" />
            <local:RunStateToLabelConverter x:Key="RunStateToLabelConverter" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Card layout: one tile per module, the board divided evenly between them -->
            <DataTemplate x:Key="ModuleCardTemplate" DataType="{x:Type vm:ModuleViewModel}">
                <materialDesign:Card Margin="4" Background="{StaticResource AppCardBackgroundBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: created date (col1) + delete X (top-right), pinned to the top -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding CreatedAtDisplay}"
                                       Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="11"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Command="{Binding EditCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                        ToolTip="Edit Module">
                                    <fa:IconBlock Icon="Pen" FontSize="12" />
                                </Button>
                                <Button Command="{Binding DeleteCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Width="24" Height="24" Padding="0"
                                        ToolTip="Remove Module">
                                    <fa:IconBlock Icon="Xmark" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Remaining content, centered as a block in the leftover space -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <!-- type icon + module name -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:IconBlock Icon="{Binding TypeIcon}" FontSize="20"
                                              Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                              VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- module type (protocol), smaller/secondary -->
                            <TextBlock Text="{Binding ModuleTypeName}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="11" Margin="0,2,0,0" />

                            <!-- play / stop / reinit + status chip (Communication Server / other hardware modules) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                        Visibility="{Binding IsScenario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Button Command="{Binding StartCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                        ToolTip="Start">
                                    <fa:IconBlock Icon="Play" FontSize="16"
                                                  fa:Awesome.Spin="{Binding IsRunning}"
                                                  Foreground="{StaticResource StatusRunningBrush}" />
                                </Button>
                                <Button Command="{Binding StopCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Stop">
                                    <fa:IconBlock Icon="Stop" FontSize="16"
                                                  Foreground="{StaticResource StatusStoppedBrush}" />
                                </Button>
                                <Button Command="{Binding ReinitCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="Re-initialize">
                                    <fa:IconBlock Icon="ArrowsRotate" FontSize="16" />
                                </Button>
                                <Border Background="{Binding State, Converter={StaticResource RunStateToBrushConverter}}"
                                        CornerRadius="8" Padding="8,2" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                               Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </StackPanel>

                            <!-- active/inactive checkbox (Scenario modules) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Visibility="{Binding IsScenario, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{Binding State, Converter={StaticResource RunStateToBrushConverter}}"
                                        CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                               Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="ACTIVE" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- summary info -->
                            <TextBlock Text="{Binding SummaryInfo}"
                                       Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="12" />
                        </StackPanel>

                        <!-- view button, pinned to the bottom of the card -->
                        <Button Grid.Row="2" Content="VIEW"
                                Command="{Binding ViewCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                    </Grid>
                </materialDesign:Card>
            </DataTemplate>

            <!-- List layout: one row per module, top to bottom -->
            <DataTemplate x:Key="ModuleRowTemplate" DataType="{x:Type vm:ModuleViewModel}">
                <materialDesign:Card Margin="4,3" Background="{StaticResource AppCardBackgroundBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Grid Margin="12,8" ToolTip="{Binding CreatedAtDisplay}">
                        <!-- Shared sizes (scope on the ItemsControl): each column is as wide as its widest
                             row needs, so the columns line up without a fixed width leaving a gap. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RowIcon" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RowName" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RowControls" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <fa:IconBlock Grid.Column="0" Icon="{Binding TypeIcon}" FontSize="18"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                        <!-- name over type -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModuleTypeName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AppDimForegroundBrush}" />
                        </StackPanel>

                        <!-- state chip + play/stop/reinit (communication servers) or the ACTIVE checkbox (scenarios) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                            <Border Background="{Binding State, Converter={StaticResource RunStateToBrushConverter}}"
                                    CornerRadius="8" Padding="8,2" Width="84" VerticalAlignment="Center">
                                <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                           Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                                        Visibility="{Binding IsScenario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Button Command="{Binding StartCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                        ToolTip="Start">
                                    <fa:IconBlock Icon="Play" FontSize="14" fa:Awesome.Spin="{Binding IsRunning}"
                                                  Foreground="{StaticResource StatusRunningBrush}" />
                                </Button>
                                <Button Command="{Binding StopCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" ToolTip="Stop">
                                    <fa:IconBlock Icon="Stop" FontSize="14" Foreground="{StaticResource StatusStoppedBrush}" />
                                </Button>
                                <Button Command="{Binding ReinitCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                        Width="32" Height="32" ToolTip="Re-initialize">
                                    <fa:IconBlock Icon="ArrowsRotate" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                        Visibility="{Binding IsScenario, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="ACTIVE" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding SummaryInfo}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SummaryInfo}"
                                   Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="12" />

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="VIEW" Command="{Binding ViewCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Height="30" Margin="0,0,8,0" />
                            <Button Command="{Binding EditCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="28" Height="28" Padding="0" ToolTip="Edit Module">
                                <fa:IconBlock Icon="Pen" FontSize="12" />
                            </Button>
                            <Button Command="{Binding DeleteCommand}" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="28" Height="28" Padding="0" ToolTip="Remove Module">
                                <fa:IconBlock Icon="Xmark" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="ModuleGridPanel">
                <UniformGrid />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="ModuleListPanel">
                <StackPanel />
            </ItemsPanelTemplate>

            <!-- The ADD MODULE item, always last on the board: a card-sized tile in the card layout,
                 a row-sized bar in the list layout. -->
            <DataTemplate x:Key="AddModuleCardTemplate">
                <materialDesign:Card Margin="4" Background="{StaticResource AppCardBackgroundBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Button Command="{Binding DataContext.OpenAddModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="Auto" Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            ToolTip="Add Module">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <fa:IconBlock Icon="Plus" FontSize="40"
                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                          HorizontalAlignment="Center" />
                            <TextBlock Text="ADD MODULE" Margin="0,8,0,0" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </materialDesign:Card>
            </DataTemplate>

            <DataTemplate x:Key="AddModuleRowTemplate">
                <materialDesign:Card Margin="4,3" Background="{StaticResource AppCardBackgroundBrush}"
                                     BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                    <Button Command="{Binding DataContext.OpenAddModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="46" HorizontalAlignment="Stretch" ToolTip="Add Module">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Plus" FontSize="16" VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <TextBlock Text="ADD MODULE" Margin="8,0,0,0" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </materialDesign:Card>
            </DataTemplate>

            <local:BoardItemTemplateSelector x:Key="CardItemSelector"
                                             ModuleTemplate="{StaticResource ModuleCardTemplate}"
                                             AddTemplate="{StaticResource AddModuleCardTemplate}" />
            <local:BoardItemTemplateSelector x:Key="RowItemSelector"
                                             ModuleTemplate="{StaticResource ModuleRowTemplate}"
                                             AddTemplate="{StaticResource AddModuleRowTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="RootDialog"
                               Background="{DynamicResource AppWindowBackgroundBrush}">
        <DockPanel LastChildFill="True" Margin="8">

            <!-- Module board. Card layout divides the space evenly (vertical scrolling is disabled so the
                 grid gets a finite height to divide); list layout stacks rows and scrolls. The switch is
                 in the window caption (BoardLayoutToggle), bound to MainViewModel.IsListLayout. -->
            <ScrollViewer Margin="4" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <!-- ItemsSource is set in code-behind: the modules followed by one AddModuleTile. -->
                <ItemsControl x:Name="Board" Grid.IsSharedSizeScope="True">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel" Value="{StaticResource ModuleGridPanel}" />
                            <Setter Property="ItemTemplateSelector" Value="{StaticResource CardItemSelector}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListLayout}" Value="True">
                                    <Setter Property="ItemsPanel" Value="{StaticResource ModuleListPanel}" />
                                    <Setter Property="ItemTemplateSelector" Value="{StaticResource RowItemSelector}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </materialDesign:DialogHost>
</UserControl>
