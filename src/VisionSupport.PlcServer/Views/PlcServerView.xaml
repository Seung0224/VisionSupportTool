<!--
    Was the standalone hub's MainWindow; now a page in the support shell. The window chrome is
    the shell's, and the Material theme that used to sit in App.xaml is merged here instead so it
    styles this feature only - see Themes/AppTheme.xaml for why that scoping matters.
-->
<UserControl x:Class="VirtualPlcServer.Views.PlcServerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
        xmlns:local="clr-namespace:VirtualPlcServer.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionSupport.PlcServer;component/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:RunStateToBrushConverter x:Key="RunStateToBrushConverter" />
            <local:RunStateToLabelConverter x:Key="RunStateToLabelConverter" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="RootDialog"
                               Background="{DynamicResource AppWindowBackgroundBrush}">
        <DockPanel LastChildFill="True" Margin="8">

            <!-- Right-edge Add Module tile -->
            <materialDesign:Card DockPanel.Dock="Right" Width="176" Margin="4"
                                  Background="{StaticResource AppCardBackgroundBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Button Command="{Binding OpenAddModuleCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Height="Auto" Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        ToolTip="Add Module">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <fa:IconBlock Icon="Plus" FontSize="40"
                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                      HorizontalAlignment="Center" />
                        <TextBlock Text="ADD MODULE" Margin="0,8,0,0" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </materialDesign:Card>

            <!-- Empty-state hint -->
            <TextBlock DockPanel.Dock="Top"
                       Text="아직 모듈이 없습니다 — 오른쪽 ADD MODULE로 가상 하드웨어를 추가하세요."
                       Visibility="{Binding HasNoModules, Converter={StaticResource BooleanToVisibilityConverter}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="16" Margin="0,32,0,0" />

            <!-- Module banners: fill remaining space, divided evenly -->
            <ItemsControl ItemsSource="{Binding Modules}" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModuleViewModel}">
                        <materialDesign:Card Margin="4" Background="{StaticResource AppCardBackgroundBrush}"
                                             BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: created date (col1) + delete X (top-right), pinned to the top -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding CreatedAtDisplay}"
                                               Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="11"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding DeleteCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="24" Height="24" Padding="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            ToolTip="Remove Module">
                                        <fa:IconBlock Icon="Xmark" FontSize="14" />
                                    </Button>
                                </Grid>

                                <!-- Remaining content, centered as a block in the leftover space -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <!-- type icon + module name -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <fa:IconBlock Icon="{Binding TypeIcon}" FontSize="20"
                                                      Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- module type (protocol), smaller/secondary -->
                                    <TextBlock Text="{Binding ModuleTypeName}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="11" Margin="0,2,0,0" />

                                    <!-- play / stop / reinit + status chip (Communication Server / other hardware modules) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                                Visibility="{Binding IsScenario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Button Command="{Binding StartCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBooleanConverter}}"
                                                ToolTip="Start">
                                            <fa:IconBlock Icon="Play" FontSize="16"
                                                          fa:Awesome.Spin="{Binding IsRunning}"
                                                          Foreground="{StaticResource StatusRunningBrush}" />
                                        </Button>
                                        <Button Command="{Binding StopCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Stop">
                                            <fa:IconBlock Icon="Stop" FontSize="16"
                                                          Foreground="{StaticResource StatusStoppedBrush}" />
                                        </Button>
                                        <Button Command="{Binding ReinitCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="Re-initialize">
                                            <fa:IconBlock Icon="ArrowsRotate" FontSize="16" />
                                        </Button>
                                        <Border Background="{Binding State, Converter={StaticResource RunStateToBrushConverter}}"
                                                CornerRadius="8" Padding="8,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- active/inactive checkbox (Scenario modules) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                                               Visibility="{Binding IsScenario, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Background="{Binding State, Converter={StaticResource RunStateToBrushConverter}}"
                                                CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State, Converter={StaticResource RunStateToLabelConverter}}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="ACTIVE" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12" />
                                            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- summary info -->
                                    <TextBlock Text="{Binding SummaryInfo}"
                                               Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource AppDimForegroundBrush}" FontSize="12" />
                                </StackPanel>

                                <!-- view button, pinned to the bottom of the card -->
                                <Button Grid.Row="2" Content="VIEW"
                                        Command="{Binding ViewCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch" Margin="0,12,0,0" />
                            </Grid>
                        </materialDesign:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </materialDesign:DialogHost>
</UserControl>
