<UserControl x:Class="VirtualPlcServer.Views.ScenarioRuleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
             xmlns:local="clr-namespace:VirtualPlcServer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScenarioRuleDialogViewModel}"
             Width="480" MaxHeight="720">
    <!-- Built with `new` and shown through DialogHost, so it has no parent to inherit the
         feature's scoped theme from at parse time. It merges the theme itself. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VisionSupport.PlcServer;component/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />

            <ComboBox materialDesign:HintAssist.Hint="Trigger" SelectedIndex="{Binding TriggerKindIndex}" Margin="0,0,0,8">
                <ComboBoxItem Content="On Value Change" />
                <ComboBoxItem Content="On Value Compare" />
                <ComboBoxItem Content="On Timer" />
            </ComboBox>

            <!-- Watch target (On Value Change / On Value Compare) -->
            <StackPanel Visibility="{Binding IsWatchNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="WHEN" FontWeight="Bold" FontSize="11" Foreground="Gray" Margin="0,8,0,4" />
                <local:TargetPicker DataContext="{Binding Watch}" />
                <ContentControl Visibility="{Binding IsCompareNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <local:ComparisonEditor DataContext="{Binding Comparison}" />
                </ContentControl>
            </StackPanel>

            <!-- Timer -->
            <StackPanel Visibility="{Binding IsTimerNeeded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="EVERY" FontWeight="Bold" FontSize="11" Foreground="Gray" Margin="0,8,0,4" />
                <TextBox materialDesign:HintAssist.Hint="Interval (seconds)" Text="{Binding TimerIntervalSeconds}" Margin="0,4" />
            </StackPanel>

            <!-- Extra conditions: AND for value triggers, a filter for the timer -->
            <ItemsControl ItemsSource="{Binding Conditions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ScenarioConditionRowViewModel}">
                        <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="8,4,8,8" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="24" Height="24" Padding="0" ToolTip="Remove Condition">
                                        <TextBlock Text="✕" FontSize="11" />
                                    </Button>
                                    <TextBlock Text="{Binding DataContext.ConditionsHeader, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               FontWeight="Bold" FontSize="11" Foreground="Gray" VerticalAlignment="Center" />
                                </DockPanel>
                                <local:TargetPicker DataContext="{Binding Target}" />
                                <local:ComparisonEditor DataContext="{Binding Comparison}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ CONDITION" Command="{Binding AddConditionCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    ToolTip="Add a condition that must also hold (AND). On a timer rule, the rule only runs while all of them hold." />

            <!-- Action -->
            <TextBlock Text="THEN WRITE" FontWeight="Bold" FontSize="11" Foreground="Gray" Margin="0,12,0,4" />
            <local:TargetPicker DataContext="{Binding Action}" />

            <TextBox materialDesign:HintAssist.Hint="Value or expression (use 'value' for the trigger's value)"
                     Visibility="{Binding Action.IsStringSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                     Text="{Binding ActionValueExpression}" Margin="0,4" />
            <TextBox materialDesign:HintAssist.Hint="Text to write"
                     Visibility="{Binding Action.IsStringSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Text="{Binding ActionTextValue}" Margin="0,4" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource StatusStoppedBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        Margin="0,0,8,0" />
                <Button Content="{Binding ConfirmText}" Click="OnAddClicked" Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
