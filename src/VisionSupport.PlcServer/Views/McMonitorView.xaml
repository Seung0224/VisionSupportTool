<UserControl x:Class="VirtualPlcServer.Views.McMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:McMonitorViewModel}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderInfo}" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="Double-click a row to write a value." Foreground="Gray"
                   FontSize="11" Margin="0,0,0,8" />

        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  MouseDoubleClick="OnRowDoubleClick"
                  materialDesign:DataGridAssist.CellPadding="8,4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Address" Binding="{Binding AddressDisplay}" Width="120" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
