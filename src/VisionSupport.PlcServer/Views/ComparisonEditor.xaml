<UserControl x:Class="VirtualPlcServer.Views.ComparisonEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:VirtualPlcServer.ViewModels"
             xmlns:local="clr-namespace:VirtualPlcServer.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ComparisonViewModel}">
    <!-- Operator + (constant or another address). Implicit styles only, as in TargetPicker. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel x:Name="Root">
        <StackPanel Orientation="Horizontal">
            <ComboBox materialDesign:HintAssist.Hint="Operator" SelectedIndex="{Binding OperatorIndex}"
                      Width="80" Margin="0,4,8,4">
                <ComboBoxItem Content="==" />
                <ComboBoxItem Content="!=" />
                <ComboBoxItem Content="&gt;" />
                <ComboBoxItem Content="&gt;=" />
                <ComboBoxItem Content="&lt;" />
                <ComboBoxItem Content="&lt;=" />
            </ComboBox>
            <ComboBox materialDesign:HintAssist.Hint="Compare to" SelectedIndex="{Binding CompareKindIndex}"
                      Width="90" Margin="0,4,8,4">
                <ComboBoxItem Content="Value" />
                <ComboBoxItem Content="Address" />
            </ComboBox>
            <TextBox materialDesign:HintAssist.Hint="Value"
                     Visibility="{Binding IsNumberValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Text="{Binding CompareValue}" Width="140" Margin="0,4" />
            <TextBox materialDesign:HintAssist.Hint="Text"
                     Visibility="{Binding IsTextValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Text="{Binding CompareText}" Width="140" Margin="0,4" />
        </StackPanel>

        <local:TargetPicker DataContext="{Binding CompareTarget}" Margin="16,0,0,0"
                            Visibility="{Binding DataContext.IsAddressCompare, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
