<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="VisionSupport.app"/>

  <!--
    The memory monitor runs inside this process, and two of the things it does cannot be done
    without administrator rights:
      - reading a target that itself runs elevated (VISION does), and
      - creating the ETW sessions behind the GC pause and native allocation views.
    Privilege is per-process, so hosting that feature in-process means the whole shell must be
    elevated. Asking for it up front avoids the confusing half-working state where processes
    are listed but cannot be attached to.
  -->
  <!--
    Without this the process is treated as system-DPI aware: Windows renders it once at the
    primary monitor's scale and stretches that bitmap onto any monitor scaled differently. On a
    dual-monitor desk that shows up the moment a window is dragged across - everything in it goes
    soft, edges worst of all. PerMonitorV2 makes WPF re-render at the new monitor's scale instead.
    The 2005 element is the Windows 8.1 spelling and is ignored where the 2016 one is understood.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
