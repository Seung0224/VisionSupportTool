<UserControl x:Class="VisionSupport.Idle.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">

    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="VISION 지원툴" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="개발 중 상시 띄워두는 보조 도구 모음입니다. 왼쪽에서 기능을 고르세요."
                           Foreground="{StaticResource FgDim}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding Clock}" FontFamily="Consolas" FontSize="18"
                           HorizontalAlignment="Right"/>
                <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,8,0,0"
                        HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PrivilegeLabel}" FontSize="11"
                               Foreground="{StaticResource Shrink}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- this process's own cost: an always-on tool has to justify its own footprint -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="20,14" Margin="0,0,0,20">
            <UniformGrid Rows="1" Columns="4">
                <StackPanel>
                    <TextBlock Text="가동 시간" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Uptime}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="지원툴 메모리" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding SelfMemory}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="지원툴 CPU" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding SelfCpu}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="스레드" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding ThreadCount}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- feature tiles -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="4" Padding="18,16" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,9,0"
                                         Fill="{Binding State, Converter={StaticResource StateBrush}}"/>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding State, Converter={StaticResource StateText}}"
                                           Foreground="{StaticResource FgDim}" FontSize="11" Margin="10,1,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap"
                                       Foreground="{StaticResource FgDim}" Margin="0,10,0,0"/>

                            <TextBlock Grid.Row="2" Text="{Binding StatusLine}" TextWrapping="Wrap"
                                       FontFamily="Consolas" FontSize="11" Margin="0,10,0,0"
                                       Visibility="{Binding StatusLine, Converter={StaticResource EmptyToVis}}"/>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="{Binding ToggleLabel}"
                                        Command="{Binding DataContext.ToggleCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{StaticResource Accent}"/>
                                <Button Content="화면 열기"
                                        Command="{Binding DataContext.OpenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- recent activity -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="4" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="최근 활동" Foreground="{StaticResource FgDim}"
                           FontSize="11" Margin="0,0,0,10"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Activity.Entries}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource FgDim}" Width="70"/>
                                <TextBlock Text="{Binding Source}" FontSize="11" Width="150"
                                           Foreground="{StaticResource FgDim}"/>
                                <TextBlock Text="{Binding Message}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
