<Window x:Class="VisionSupport.Launcher.LinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="링크 편집" Width="560" Height="520"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" Opacity="0.95"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0"
                             ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Bg}" CornerRadius="{StaticResource RadiusWindow}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,0,10">
                <TextBlock Text="링크 편집" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                        Content="&#xE8BB;" HorizontalAlignment="Right"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Two lists, because the two kinds live differently on the ring: a web link is
                     a tile of its own, folders share one tile and a list of their own. -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="웹 링크" FontSize="11"
                               Foreground="{StaticResource FgDim}" Margin="2,0,0,3"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding WebLinks}"
                             SelectedItem="{Binding SelectedWeb}"
                             DisplayMemberPath="Title" BorderThickness="1" MinHeight="52"/>
                    <Button Grid.Row="2" Content="웹 추가" Command="{Binding AddWebCommand}"
                            HorizontalAlignment="Left" MinWidth="80" Margin="0,6,0,0"/>

                    <TextBlock Grid.Row="3" Text="{Binding FolderCountLabel}" FontSize="11"
                               Foreground="{StaticResource FgDim}" Margin="2,12,0,3"/>
                    <ListBox Grid.Row="4" ItemsSource="{Binding FolderLinks}"
                             SelectedItem="{Binding SelectedFolder}"
                             DisplayMemberPath="Title" BorderThickness="1" MinHeight="80"/>
                    <Button Grid.Row="5" Content="폴더 추가" Command="{Binding AddFolderCommand}"
                            HorizontalAlignment="Left" MinWidth="80" Margin="0,6,0,0"/>

                    <Button Grid.Row="6" Content="삭제" Command="{Binding RemoveCommand}"
                            HorizontalAlignment="Left" MinWidth="80" Margin="0,10,0,0"/>
                </Grid>

                <StackPanel Grid.Column="1"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                            DataContext="{Binding Selected}">
                    <TextBlock Text="이름" FontSize="11" Foreground="{StaticResource FgDim}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,10"/>

                    <TextBlock Text="{Binding TargetLabel}" FontSize="11"
                               Foreground="{StaticResource FgDim}"/>
                    <Grid Margin="0,3,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="False"/>
                        <!-- Folders get a picker. A network path typed by hand is where the
                             typos are, and a wrong one fails silently at the far end. -->
                        <Button Grid.Column="1" Content="찾아보기" Margin="6,0,0,0" MinWidth="70"
                                Command="{Binding DataContext.BrowseCommand,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding IsWeb,
                                            Converter={StaticResource BoolToVis},
                                            ConverterParameter=invert}"/>
                    </Grid>

                    <TextBlock Text="아이콘 (Material Design 이름 &#8212; 예: EmailEditOutline, FolderOutline)"
                               FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding Glyph, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,3,0,10"/>

                    <!-- A folder opens in Explorer, which sizes its own window. -->
                    <StackPanel Visibility="{Binding IsWeb, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="팝업 창 크기" FontSize="11" Foreground="{StaticResource FgDim}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBox Text="{Binding Width}" Width="70"/>
                            <TextBlock Text="×" Margin="8,0" Foreground="{StaticResource FgDim}"/>
                            <TextBox Text="{Binding Height}" Width="70"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
