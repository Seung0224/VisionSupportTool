<Window x:Class="VisionSupport.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="72" Height="72" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- One tile: a rounded square that grows a little under the pointer and dips when
             pressed. The cursor deliberately never changes - a shape-shifting pointer over a
             floating widget reads as a resize handle, which this is not. -->
        <Style x:Key="MenuTile" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <Border x:Name="Chrome" CornerRadius="{StaticResource RadiusTile}"
                                    Background="{TemplateBinding Background}" BorderThickness="1"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3"
                                                      Direction="270" Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                            </Border>

                            <!-- Hover brightens with a white wash rather than a second colour, so
                                 the highlight follows whatever hue the user picked instead of
                                 needing its own palette entry. -->
                            <Border x:Name="Glow" CornerRadius="{StaticResource RadiusTile}"
                                    Background="White" Opacity="0"/>

                            <!-- The running ring. A feature can be up with no window open, and
                                 this is the only place that says so at a glance. -->
                            <Border BorderBrush="{StaticResource StateRunning}" BorderThickness="2"
                                    CornerRadius="{StaticResource RadiusTile}"
                                    Visibility="{Binding IsRunning,
                                                Converter={StaticResource BoolToVis}}"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.20" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- A press dip, and back to the hover size on release - the pointer
                                 is by definition still over the tile at that point. Storyboards
                                 rather than Setters because a Setter cannot target a transform. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.10"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Background is {x:Null}, not Transparent: a null background is not hit-testable, so
         clicks in the empty area around the icon reach whatever is behind the launcher. -->
    <Grid Background="{x:Null}">

        <!-- Cached as a bitmap for the open/close animation. A transparent window renders in
             software, and scaling four tiles - each with a drop shadow, a vector icon and a
             label - re-rasterises all of that on every frame. Cached, the animation scales one
             ready-made bitmap instead, which is the difference between stuttering and smooth. -->
        <ItemsControl x:Name="Menu" ItemsSource="{Binding Items}" Visibility="Collapsed"
                      Opacity="0" RenderTransformOrigin="0.5,0.5"
                      CacheMode="BitmapCache">
            <ItemsControl.RenderTransform>
                <ScaleTransform x:Name="MenuScale" ScaleX="0.35" ScaleY="0.35"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="88" HorizontalAlignment="Center">
                        <!-- Tiles wear the same hue as the icon that opened them, so the colour
                             slider moves the whole launcher rather than just the circle. -->
                        <Button Style="{StaticResource MenuTile}"
                                Command="{Binding ActivateCommand}"
                                HorizontalAlignment="Center"
                                Background="{Binding DataContext.Appearance.IconBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                BorderBrush="{Binding DataContext.Appearance.IconEdgeBrush,
                                             RelativeSource={RelativeSource AncestorType=Window}}">
                            <icons:PackIconMaterial Kind="{Binding Glyph}" Width="24" Height="24"
                                                    Foreground="White"/>
                        </Button>

                        <!-- The label carries its own dark pill: the desktop behind the launcher
                             can be any colour, and bare text on it is unreadable half the time. -->
                        <Border Margin="0,7,0,0" HorizontalAlignment="Center"
                                CornerRadius="{StaticResource RadiusPill}"
                                Background="#E61A1A1A" Padding="9,3">
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       Foreground="{StaticResource Fg}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="Fab" Background="{x:Null}"
              Width="{Binding Appearance.IconSize}" Height="{Binding Appearance.IconSize}"
              Opacity="{Binding Appearance.IconOpacity}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FabZoom" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Ellipse Fill="{Binding Appearance.IconBrush}"
                     Stroke="{Binding Appearance.IconEdgeBrush}" StrokeThickness="1">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                                      Opacity="0.6" Color="Black"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Stroke="{StaticResource StateRunning}" StrokeThickness="2.5" Margin="1"
                     Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}"/>

            <!-- VISION's V. Rotating it to a caret on expand is the open/close affordance; it is
                 also the only moving part that tells you the menu heard the click. -->
            <TextBlock x:Name="FabMark" Text="V" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="{Binding Appearance.IconMarkSize}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="FabRotate" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid.ContextMenu>
                <ContextMenu Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
                    <MenuItem x:Name="OverviewMenuItem" Header="전체보기"/>
                    <Separator/>
                    <MenuItem x:Name="ExitMenuItem" Header="종료"/>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Grid>
</Window>
