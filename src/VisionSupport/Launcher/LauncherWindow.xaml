<Window x:Class="VisionSupport.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="72" Height="72" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One tile: a rounded square that grows a little under the pointer and dips when
             pressed. The cursor deliberately never changes - a shape-shifting pointer over a
             floating widget reads as a resize handle, which this is not. -->
        <Style x:Key="MenuTile" TargetType="Button">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- No drop shadow, deliberately.

                                 An Effect makes WPF render its whole subtree into an intermediate
                                 surface at less than screen resolution, so a shadow on the tile
                                 softened the tile. Moving the shadow to a black rectangle behind
                                 the tile fixed that and introduced a worse artefact: the tile's
                                 antialiased edge is part-transparent, so the black underneath
                                 showed through it as a hairline crack just inside the rim.

                                 The 2px rim does the separating instead. It costs some depth and
                                 buys an edge that is actually sharp.

                                 A 2px rim rather than 1px: at one pixel the edge is a single
                                 half-lit line against whatever wallpaper is behind it, which
                                 reads as blur rather than as an edge.

                                 Rectangle, not Border, and that is the whole point of this
                                 element. A Border paints its background and its border as two
                                 separate geometries, and on a rounded corner a sub-pixel gap
                                 opens between them. On an opaque window nobody notices; on a
                                 transparent one the desktop shows through that gap, which on a
                                 dark desktop is a black hairline between the rim and the fill.
                                 A Shape strokes and fills one geometry, so there is no seam to
                                 show through.

                                 The radius is 18 to match Theme/Dark.xaml's RadiusTile - a
                                 CornerRadius resource cannot be bound to RadiusX/RadiusY. -->
                            <Rectangle x:Name="Chrome" RadiusX="18" RadiusY="18"
                                       Fill="{TemplateBinding Background}"
                                       Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2"/>

                            <!-- Hover brightens with a white wash rather than a second colour, so
                                 the highlight follows whatever hue the user picked instead of
                                 needing its own palette entry. -->
                            <Rectangle x:Name="Glow" RadiusX="18" RadiusY="18"
                                       Fill="White" Opacity="0"/>

                            <!-- The running ring. A feature can be up with no window open, and
                                 this is the only place that says so at a glance. -->
                            <Rectangle RadiusX="18" RadiusY="18"
                                       Stroke="{StaticResource StateRunning}" StrokeThickness="2"
                                       Visibility="{Binding IsRunning,
                                                   Converter={StaticResource BoolToVis}}"/>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.20" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- A press dip that is lifted rather than undone.

                                 Releasing used to animate back to the hover size, on the
                                 assumption that the pointer is still over the tile. Clicking a
                                 tile shuts the menu, so it is not: the tile was left holding the
                                 hover size, and the next time the menu opened that one icon was
                                 12% bigger than its neighbours.

                                 RemoveStoryboard takes the dip off and lets whatever the hover
                                 trigger is holding show through - the hover size while the
                                 pointer is there, the resting size once it has left. There is no
                                 size written here for the two to disagree about. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PressDip">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="Zoom"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="PressDip"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Background is {x:Null}, not Transparent: a null background is not hit-testable, so
         clicks in the empty area around the icon reach whatever is behind the launcher. -->
    <Grid x:Name="LauncherRoot" Background="{x:Null}">

        <!-- Cached as a bitmap for the open/close animation. A transparent window renders in
             software, and scaling four tiles - each with a drop shadow, a vector icon and a
             label - re-rasterises all of that on every frame. Cached, the animation scales one
             ready-made bitmap instead, which is the difference between stuttering and smooth. -->
        <ItemsControl x:Name="Menu" ItemsSource="{Binding Items}" Visibility="Collapsed"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
            <!-- No CacheMode here on purpose. A bitmap cache is what keeps the open/close
                 animation smooth, but leaving one on afterwards means the tiles sit on screen as
                 a bitmap rather than as vectors, which is what made them look soft. The code
                 attaches one for the length of the animation and takes it off again. -->
            <ItemsControl.RenderTransform>
                <ScaleTransform x:Name="MenuScale" ScaleX="0.35" ScaleY="0.35"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The tile is the whole item. Names live in the tooltip rather than under
                         each tile: a caption pinned to a floating widget has to carry its own
                         background to stay readable over an unknown desktop, and a row of little
                         dark pills around the ring was more furniture than the four words were
                         worth. The icons carry the meaning; the tooltip settles any doubt.

                         Tiles wear the same hue as the icon that opened them, so the colour
                         slider moves the whole launcher rather than just the circle. -->
                    <Button Style="{StaticResource MenuTile}"
                            Command="{Binding ActivateCommand}" ToolTip="{Binding Title}"
                            HorizontalAlignment="Center"
                            Width="{Binding DataContext.Appearance.TileSize,
                                   RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding DataContext.Appearance.TileSize,
                                    RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{Binding DataContext.Appearance.IconBrush,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                            BorderBrush="{Binding DataContext.Appearance.IconEdgeBrush,
                                         RelativeSource={RelativeSource AncestorType=Window}}">
                        <icons:PackIconMaterial Kind="{Binding Glyph}" Foreground="White"
                            Width="{Binding DataContext.Appearance.TileIconSize,
                                   RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="{Binding DataContext.Appearance.TileIconSize,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The folder list. A Popup rather than a panel inside the window: it can extend past
             the window's edge, so the launcher does not have to grow a wing to hold it, and it
             dismisses itself when something else is clicked. -->
        <!-- HorizontalOffset is set when the list opens: it has to clear the ring, and the ring's
             radius follows the tile and icon sizes the user chose. -->
        <Popup x:Name="FolderList" PlacementTarget="{Binding ElementName=Fab}" Placement="Left"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <!-- The list wears the launcher's own colour: same hue on the rim, same hue behind
                 a row under the pointer. A neutral grey panel next to a coloured ring reads as a
                 different program's menu. -->
            <Border Background="{StaticResource Panel}" BorderThickness="2"
                    BorderBrush="{Binding DataContext.Appearance.IconEdgeBrush,
                                 ElementName=LauncherRoot}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="6" MaxHeight="420">
                <ItemsControl ItemsSource="{Binding FolderLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Not focusable: a focusable button inside the popup pulls focus
                                 off the launcher window, which deactivates it and folds the
                                 menu away underneath the list being read. -->
                            <Button MinWidth="180" Margin="0,0,0,2" Focusable="False"
                                    ToolTip="{Binding Url}"
                                    Command="{Binding DataContext.OpenFolderCommand,
                                             ElementName=LauncherRoot}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Rectangle x:Name="Hover" RadiusX="10" RadiusY="10"
                                                       Opacity="0"
                                                       Fill="{Binding DataContext.Appearance.IconBrush,
                                                             ElementName=LauncherRoot}"/>
                                            <ContentPresenter Margin="10,7"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconMaterial Kind="{Binding Glyph}" Width="15"
                                                            Height="15" Margin="0,0,9,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding DataContext.Appearance.IconEdgeBrush,
                                                                        ElementName=LauncherRoot}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>

        <Grid x:Name="Fab" Background="{x:Null}"
              Width="{Binding Appearance.IconSize}" Height="{Binding Appearance.IconSize}"
              Opacity="{Binding Appearance.IconOpacity}"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FabZoom" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <!-- No shadow here either; see the tile template for why. -->
            <Ellipse Fill="{Binding Appearance.IconBrush}"
                     Stroke="{Binding Appearance.IconEdgeBrush}" StrokeThickness="2"/>

            <!-- Lights up while something is held over the icon. A white wash rather than a
                 second colour, so it follows whatever hue the user picked. -->
            <Ellipse x:Name="DropGlow" Fill="White" Opacity="0"/>

            <Ellipse Stroke="{StaticResource StateRunning}" StrokeThickness="2.5" Margin="1"
                     Visibility="{Binding AnyRunning, Converter={StaticResource BoolToVis}}"/>

            <!-- VISION's V. Rotating it to a caret on expand is the open/close affordance; it is
                 also the only moving part that tells you the menu heard the click. -->
            <!-- A ring that fills as a job runs, drawn as an arc's worth of stroke. Reading a
                 percentage off a small circle is hard; watching one close is not. -->
            <Ellipse x:Name="Progress" Stroke="White" StrokeThickness="3" Margin="4"
                     Opacity="0.9" Visibility="Collapsed"
                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Text, size and colour are all set from code: they follow the drop's state, not
                 just the icon's size, and one binding cannot express both. -->
            <TextBlock x:Name="FabMark" Text="V" FontFamily="Segoe UI" FontWeight="Black"
                       FontSize="{Binding Appearance.IconMarkSize}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="FabRotate" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <Grid.ContextMenu>
                <ContextMenu Background="{StaticResource Panel}" Foreground="{StaticResource Fg}">
                    <MenuItem x:Name="OverviewMenuItem" Header="전체보기"/>
                    <MenuItem x:Name="LinksMenuItem" Header="링크 편집"/>
                    <Separator/>
                    <MenuItem x:Name="ArchiveMenuItem" Header="압축 설정"/>
                    <Separator/>
                    <MenuItem x:Name="ExitMenuItem" Header="종료"/>
                </ContextMenu>
            </Grid.ContextMenu>
        </Grid>
    </Grid>
</Window>
