<?xml version="1.0" encoding="utf-8"?>
<!--
  Deployment build: one self-contained executable, no .NET runtime needed on the target PC.

  Two settings here are not optional for this app.

  IncludeNativeLibrariesForSelfExtract carries SkiaSharp's native DLL, which the memory monitor's
  charts need. Without it the exe builds and starts, then dies the moment a chart is drawn.

  PublishTrimmed stays off. The shell finds the Cognex codec by reflection, every view is XAML,
  and the icon tiles name their icons with strings - none of which a trimmer can see, so it would
  remove exactly the parts that only fail at runtime.

  DebugType is embedded rather than none: line numbers stay available in the exception messages
  the launcher surfaces, without shipping a second file for them.

  Usage:
    dotnet publish src/VisionSupport -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\..\dist\</PublishDir>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>

    <!-- The feature libraries build their own .pdb files, which would otherwise sit next to the
         exe in the deployment folder. Their symbols are embedded in the single file already. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
