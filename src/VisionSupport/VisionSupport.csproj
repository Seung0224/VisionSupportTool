<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The memory monitor attaches to x64 targets with ClrMD, and the reader must match the
         target's bitness. Pinning x64 makes that constraint explicit for the whole app. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VisionSupport</AssemblyName>
    <RootNamespace>VisionSupport</RootNamespace>
    <!-- Always runs elevated; see the comment in app.manifest for why. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The pure halves of the interop helpers (parsing a registry command, building a command
       line) are worth testing but not worth publishing, so the tests see internals rather than
       the helpers growing a public surface for their benefit. -->
  <ItemGroup>
    <InternalsVisibleTo Include="VisionSupport.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- The hosted features. The dependency only runs this way: a feature never references the
       shell, so nothing inside a feature can reach the nav rail or the other features. -->
  <ItemGroup>
    <ProjectReference Include="..\VisionSupport.MemoryMonitor\VisionSupport.MemoryMonitor.csproj" />
    <ProjectReference Include="..\VisionSupport.PlcServer\VisionSupport.PlcServer.csproj" />
    <ProjectReference Include="..\VisionSupport.ImageConverter\VisionSupport.ImageConverter.csproj" />
    <ProjectReference Include="..\VisionSupport.Sam\VisionSupport.Sam.csproj" />
    <ProjectReference Include="..\VisionSupport.Wireshark\VisionSupport.Wireshark.csproj" />
  </ItemGroup>

  <!-- The DirectML and ONNX Runtime packages ship debug symbols and an import library as native
       assets. Neither is used at run time, and a single-file publish cannot bundle them, so they
       would sit loose beside the exe. -->
  <Target Name="DropNativeDebugFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' Or '%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>

</Project>
