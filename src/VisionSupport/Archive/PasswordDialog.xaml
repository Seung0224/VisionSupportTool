<Window x:Class="VisionSupport.Archive.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="비밀번호" Width="360" SizeToContent="Height"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" Opacity="0.95"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        UseLayoutRounding="True">

    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0"
                             ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Bg}" CornerRadius="{StaticResource RadiusWindow}" Padding="16">
        <StackPanel>
            <TextBlock x:Name="Prompt" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,10"/>

            <PasswordBox x:Name="Entry" Height="30" Padding="8,0" VerticalContentAlignment="Center"
                         Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                         BorderBrush="{StaticResource Border}"/>

            <TextBlock x:Name="Hint" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource FgDim}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Content="취소" MinWidth="72"/>
                <Button x:Name="OkButton" Content="확인" MinWidth="72" Margin="0"
                        Style="{StaticResource AccentButton}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
