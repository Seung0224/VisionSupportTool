<Window x:Class="VisionSupport.Archive.ArchiveSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="압축 설정" Width="440" SizeToContent="Height"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" Opacity="0.95"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0"
                             ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </chrome:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Bg}" CornerRadius="{StaticResource RadiusWindow}" Padding="14">
        <StackPanel>
            <Grid Margin="2,0,0,10">
                <TextBlock Text="압축 설정" FontSize="14" FontWeight="SemiBold"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                        Content="&#xE8BB;" HorizontalAlignment="Right"
                        chrome:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <TextBlock Margin="2,0,0,12" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource FgDim}"
                       Text="아이콘 위에 파일이나 폴더를 끌어다 놓으면 같은 위치에 압축됩니다. 압축 파일만 놓으면 같은 위치에 풀립니다."/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="UsePassword" Content="비밀번호 사용"/>
                    <TextBlock Margin="25,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource FgDim}"
                               Text="압축할 때마다 비밀번호를 묻습니다. AES-256으로 잠기며, 비밀번호는 어디에도 저장하지 않습니다."/>

                    <CheckBox x:Name="FastCompress" Content="빠른 압축" Margin="0,14,0,0"/>
                    <TextBlock Margin="25,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource FgDim}"
                               Text="끄면 더 작게 압축하지만 오래 걸립니다."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="CopyMode" Content="복사 모드"/>
                    <TextBlock Margin="25,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource FgDim}"
                               Text="켜면 압축하지 않고 아래 폴더로 복사만 합니다. 원본은 그대로 두고, 같은 이름이 있으면 (1)을 붙입니다."/>

                    <TextBlock Text="복사 대상 폴더" FontSize="11" Margin="0,14,0,3"
                               Foreground="{StaticResource FgDim}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CopyTarget" Grid.Column="0" IsReadOnly="True"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="찾아보기"
                                Margin="6,0,0,0" MinWidth="70"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
